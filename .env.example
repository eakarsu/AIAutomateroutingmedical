NODE_ENV=development
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
BACKEND_PORT=4000
FRONTEND_PORT=3000
CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://dispatch_app:replace-me@localhost:5432/medical_dispatch
JWT_SECRET=replace-with-at-least-32-random-characters
ENABLE_REMINDER_SCHEDULER=false
CAD_BASE_URL=
AVL_BASE_URL=
TRAFFIC_BASE_URL=
HOSPITAL_STATUS_URL=
RADIO_GATEWAY_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
